{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ndBrain",
  "version": "0.1.0",
  "identifier": "ch.b8n.ndbrain",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Capture a thought into today's note",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
