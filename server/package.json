{
  "name": "@ndbrain/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning dist/server/scripts/smoke.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "chokidar": "^5.0.0",
    "fast-diff": "^1.3.0",
    "fastify": "^5.12.5",
    "lib0": "^0.2.119",
    "node-diff3": "^3.2.1",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yazl": "^3.3.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
