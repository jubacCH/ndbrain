node_modules/
dist/
coverage/
*.log

# Rust build output for the Mac client. `gen/schemas` is written by
# tauri-build on every build from the capabilities and the installed plugins.
desktop/target/
desktop/app/gen/schemas/

# runtime data — never commit a vault or an index
data/
vaults/
*.db
*.db-shm
*.db-wal

.env
.env.*
!.env.example

.DS_Store
Thumbs.db

# Working state of the agent tooling, including whole worktrees. Excluded in
# `.git/info/exclude` on the machine this was built on, which is local to that
# clone — here so it holds for everybody.
.claude/

# Per-instance deployment tweaks; never the same on two machines.
docker-compose.override.yml
